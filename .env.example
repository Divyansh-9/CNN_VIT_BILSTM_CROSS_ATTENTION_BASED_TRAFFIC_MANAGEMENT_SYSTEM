# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- MQTT (NFR-11: allow_anonymous false) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
INTERSECTION_ID=int01

# ---- Dashboard / API auth (NFR-12) ----
DASHBOARD_PASSWORD=

# ---- Sign-in for the dashboard (server/auth.py) ----
# Accounts are created on the Register page; there is no default account and no
# password here. Every value below is optional.
STMS_AUTH_DB=data/server/auth.sqlite        # users and sessions (gitignored folder)
STMS_COOKIE_SECURE=                          # set to 1 whenever the page is served over HTTPS
STMS_SESSION_HOURS=12                        # a session's longest life without "Remember me"
STMS_SESSION_IDLE_MINUTES=120                # ... and its longest idle time
STMS_REMEMBER_DAYS=30                        # a "Remember me" session's life
STMS_PUBLIC_URL=http://127.0.0.1:8000        # the address put in password-reset links
# Password-reset e-mail. Unset: the message is written to STMS_AUTH_OUTBOX instead.
STMS_SMTP_HOST=
STMS_SMTP_PORT=587
STMS_SMTP_USER=
STMS_SMTP_PASSWORD=
STMS_SMTP_FROM=
STMS_AUTH_OUTBOX=data/server/outbox

# ---- Paths ----
DATA_ROOT=./data
FRAME_STORE=./data/frames
FEATURE_CACHE=./data/cache
RESULTS_DIR=./experiments/results

# ---- Experiment provenance (recorded in every artifact) ----
DETECTOR_WEIGHTS=bootstrap_v0
