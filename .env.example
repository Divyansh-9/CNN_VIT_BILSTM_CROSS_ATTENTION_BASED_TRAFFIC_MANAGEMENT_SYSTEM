# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- MQTT (NFR-11: allow_anonymous false) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
INTERSECTION_ID=int01

# ---- Dashboard / API auth (NFR-12) ----
DASHBOARD_PASSWORD=

# ---- Paths ----
DATA_ROOT=./data
FRAME_STORE=./data/frames
FEATURE_CACHE=./data/cache
RESULTS_DIR=./experiments/results

# ---- Experiment provenance (recorded in every artifact) ----
DETECTOR_WEIGHTS=bootstrap_v0
