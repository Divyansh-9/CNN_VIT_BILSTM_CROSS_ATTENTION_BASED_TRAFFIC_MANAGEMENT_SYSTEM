# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Secrets / local config ----
.env
.env.local
*.pem
secrets.yaml

# ---- Data (NEVER commit raw video — NFR-13 / privacy, and size) ----
data/raw/
data/interim/
data/video/
*.mp4
*.mov
*.avi
*.mkv

# Frames and derived arrays are regenerable — keep them out of git
data/frames/
data/sequences/
*.npy
*.npz

# ---- Experiment outputs ----
runs/
mlruns/
lightning_logs/
tensorboard/
wandb/
*.log

# ---- SUMO ----
*.sumocfg.bak
simulation/output/
tripinfo*.xml
*.dump.xml

# ---- Node / dashboard ----
node_modules/
dashboard/dist/
dashboard/.vite/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Exceptions: these small artifacts MUST be committed (NFR-09) ----
!experiments/results/**/*.csv
!experiments/results/**/*.json
experiments/results/cache/
*.pt

# SUMO network build outputs are committed; nothing else here
simulation/networks/*.tmp

# Weights live on Hugging Face, not in git (ADR-013 rev 2)
models/

# Dev footage — never committed, never published (ADR-013, P10, NFR-13)
data/dev_footage/

# Converted training sets — regenerate with scripts/prepare_idd.py
data/idd_yolo/
data/idd_smoke/

# Kaggle dataset metadata is copied in at push time
data/idd_yolo/dataset-metadata.json

# Playwright MCP artifacts — CREDENTIALS CAN LAND HERE
.playwright-mcp/

# Detector weights live on Hugging Face, not git (ADR-013 rev 2)
models/detector/

# Elevated evaluation set — rebuildable by scripts/prepare_bmd45.py
data/bmd45_eval/
data/_bmd45_annotations.json

# M2 baseline scratch — rebuildable by scripts/verify_m2_baseline.py
data/_m2_coco_indexed/

# Bellevue dev footage — rebuildable via gdown, never published (NFR-13, P10)
data/dev_footage/

# SUMO tripinfo scratch — swept per environment (see traffic_env)
data/_tripinfo/
